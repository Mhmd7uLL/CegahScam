# Salin file ini menjadi .env (jangan pernah commit .env).

# Port backend utama kamu
PORT=3000

# Origin frontend yang boleh memanggil backend (Vite default)
CORS_ORIGIN=http://localhost:3000

# Alamat CegahScam AI Service (FastAPI tim AI)
AI_SERVICE_URL=http://127.0.0.1:8000

# HARUS sama dengan CEGAHSCAM_API_TOKEN di .env milik AI Service.
# Nilai ini hanya disimpan di server, JANGAN ditaruh di frontend.
AI_API_TOKEN=isi-token-rahasia-di-sini
